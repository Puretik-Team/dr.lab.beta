{
  "name": "lab-beta",
  "version": "1.2.4",
  "homepage": "./",
  "main": "index.js",
  "targets": {
    "main": false
  },
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@parcel/watcher": "^2.5.1",
    "antd": "^5.5.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.11.1",
    "bwip-js": "^4.5.1",
    "caniuse-lite": "^1.0.30001641",
    "cors": "^2.8.5",
    "csv": "^6.3.10",
    "csv-parser": "^3.0.0",
    "dayjs": "^1.11.7",
    "dayjs-plugin-utc": "^0.1.2",
    "dotenv": "^16.6.1",
    "dropbox": "^10.34.0",
    "electron-is-dev": "^2.0.0",
    "electron-log": "^5.1.7",
    "electron-updater": "^6.2.1",
    "express": "^4.19.2",
    "file-dialog": "^0.0.8",
    "form-data": "^4.0.0",
    "framer-motion": "^11.3.19",
    "get-file-object-from-local-path": "^1.0.2",
    "get-port": "^7.1.0",
    "i18next": "^23.12.2",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-electron-fs-backend": "^3.0.2",
    "image-js": "^0.35.6",
    "jimp": "^0.22.12",
    "json-2-csv": "^5.5.5",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.5.29",
    "jwt-decode": "^4.0.0",
    "libphonenumber-js": "^1.12.22",
    "lightningcss": "^1.29.2",
    "nanoid": "^4.0.2",
    "node-html-to-image": "^5.0.0",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^7.0.12",
    "pdf-to-printer": "^5.6.0",
    "pdfjs-dist": "^3.11.174",
    "pdfkit": "^0.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.0.0",
    "react-icons": "^5.2.1",
    "react-phone-input-2": "^2.15.1",
    "react-router-dom": "^6.11.2",
    "sharp": "^0.33.5",
    "zustand": "^4.3.8"
  },
  "scripts": {
    "start": "concurrently \"npx parcel --no-cache --port=3001 ./index.html\" \"wait-on http://localhost:3001 && electron index.js .\"",
    "build": "node packager.js win32 ia32",
    "build-mac": "node packager.js darwin arm64",
    "prebuild": "npm run react-build",
    "prebuild-mac": "npm run react-build",
    "react-build": "parcel build --no-cache splash.html index.html --public-url ./",
    "rebuild": "npx electron-rebuild -f -w better-sqlite3",
    "package": "electron-builder",
    "package:win": "electron-builder --win",
    "release:upload": "node scripts/uploadRelease.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "assert": "^2.1.0",
    "autoprefixer": "^10.4.20",
    "aws4": "^1.13.2",
    "browserify-zlib": "^0.2.0",
    "buffer": "^5.5.0",
    "concurrently": "^8.0.1",
    "crypto-browserify": "^3.12.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "electron-rebuild": "^3.2.9",
    "events": "^3.3.0",
    "parcel": "2.8.3",
    "path-browserify": "^1.0.1",
    "postcss": "^8.4.41",
    "process": "^0.11.10",
    "querystring-es3": "^0.2.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "tailwindcss": "^3.4.10",
    "tailwindcss-bg-patterns": "^0.3.0",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "sqlite.electron-test.app",
    "productName": "Dr.Lab",
    "extends": null,
    "npmRebuild": false,
    "publish": {
      "provider": "generic",
      "url": "https://drlab.us-east-1.linodeobjects.com/release/${os}"
    },
    "files": [
      "./index.js",
      "src/**/*",
      "dist/**/*",
      "./initPDF.js",
      "./node_modules/**/*",
      "./Frutiger-normal.js",
      "./splash.html",
      "./defaultHeader.png"
    ],
    "win": {
      "icon": "logo.png",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "icon.icns"
    },
    "afterSign": "scripts/afterSign.js",
    "directories": {
      "app": ".",
      "buildResources": "public",
      "output": "out"
    },
    "extraResources": [
      "./drlab.sql"
    ]
  },
  "optionalDependencies": {
    "@img/sharp-win32-ia32": "^0.33.5"
  }
}
